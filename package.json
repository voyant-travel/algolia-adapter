{
	"name": "@voyant-travel/algolia-adapter",
	"version": "0.0.0",
	"description": "Algolia search provider for Voyant Catalog",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@10.12.4",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/voyant-travel/algolia-adapter.git"
	},
	"bugs": {
		"url": "https://github.com/voyant-travel/algolia-adapter/issues"
	},
	"homepage": "https://github.com/voyant-travel/algolia-adapter#readme",
	"engines": {
		"node": ">=20"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./provider": {
			"types": "./dist/provider.d.ts",
			"import": "./dist/provider.js",
			"default": "./dist/provider.js"
		},
		"./voyant": {
			"types": "./dist/voyant.d.ts",
			"import": "./dist/voyant.js",
			"default": "./dist/voyant.js"
		}
	},
	"files": [
		"dist"
	],
	"voyant": {
		"schemaVersion": "voyant.package.v1",
		"kind": "plugin",
		"manifest": "./voyant"
	},
	"scripts": {
		"build": "pnpm run clean && tsc -p tsconfig.json",
		"clean": "rm -rf dist coverage tsconfig.tsbuildinfo",
		"typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
		"test": "vitest run",
		"test:conformance": "tsx scripts/conformance.ts",
		"lint": "biome check .",
		"prepack": "pnpm run build"
	},
	"peerDependencies": {
		"@voyant-travel/catalog-contracts": "^0.111.0",
		"@voyant-travel/core": "^0.122.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.2.0",
		"@types/node": "^24.0.0",
		"@voyant-travel/catalog-contracts": "^0.111.0",
		"@voyant-travel/core": "^0.122.1",
		"tsx": "^4.20.0",
		"typescript": "^5.9.2",
		"vitest": "^3.2.4"
	}
}
